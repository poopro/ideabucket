# 必填:跟 @BotFather 申請
TELEGRAM_BOT_TOKEN=

# 必填：你的 Telegram 數字 user ID（可詢問 @userinfobot）
TELEGRAM_OWNER_USER_ID=

# 必填:https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 摘要模型,可換。更省:google/gemini-3.1-flash-lite;零成本測試可用 OpenRouter 上的 :free 模型(有速率限制)
MODEL=google/gemini-2.5-flash

# 選填:開工包(/plan)和夜間推進(/night)用的強模型——一天只跑幾次,值得用好的。
# 沒設就跟 MODEL 一樣。推薦:deepseek/deepseek-v4-pro(規劃強)或 qwen/qwen3.5-plus(繁中文筆好)
MODEL_SMART=

# 選填:Jina Reader 金鑰(沒填也能用,速率較低)https://jina.ai/reader
JINA_API_KEY=

# 選填：提高 GitHub API 額度、讀取你有權限的 private repo
GITHUB_TOKEN=

# setup.bat 會自動產生，不要分享，也不要提交到 Git
CAPTURE_TOKEN=

# Chrome extension 用的本機端口（改了也要更新 extension/config.js）
CAPTURE_PORT=8787

# 排程時區
TZ_NAME=Asia/Taipei

# 啟動 bot 時是否自動用預設瀏覽器打開 dashboard(1=開,0=不開)
OPEN_DASHBOARD=1
