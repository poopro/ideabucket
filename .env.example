# 必填:跟 @BotFather 申請
TELEGRAM_BOT_TOKEN=

# 必填:https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 摘要模型,可換。更省:google/gemini-3.1-flash-lite;零成本測試可用 OpenRouter 上的 :free 模型(有速率限制)
MODEL=google/gemini-2.5-flash

# 選填:開工包(/plan)和夜間推進(/night)用的強模型——一天只跑幾次,值得用好的。
# 沒設就跟 MODEL 一樣。推薦:deepseek/deepseek-v4-pro(規劃強)或 qwen/qwen3.5-plus(繁中文筆好)
MODEL_SMART=

# 選填:Jina Reader 金鑰(沒填也能用,速率較低)https://jina.ai/reader
JINA_API_KEY=

# Chrome extension 用的本機端口(改了的話 extension/background.js 也要改)
CAPTURE_PORT=8787

# 啟動 bot 時是否自動用預設瀏覽器打開 dashboard(1=開,0=不開)
OPEN_DASHBOARD=1
